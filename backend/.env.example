# Required for LLM report generation (free at console.groq.com)
GROQ_API_KEY=your_key_here
GROQ_MODEL=llama3-8b-8192

# Admin endpoints
ADMIN_API_KEY=choose_a_secret_key

# OTLP traces to Phoenix UI (optional; docker-compose sets this for the api service)
# PHOENIX_OTLP_ENDPOINT=http://127.0.0.1:6006/v1/traces

# Analysis tuning (optional)
ANOMALY_ZSCORE_THRESHOLD=2.5
MAX_CLUSTERS=8
# Max unique error messages to encode for clustering (higher = more accurate, slower)
MAX_CLUSTER_ENCODE_SAMPLES=200
TIMELINE_MAX_EVENTS=100

# API behaviour (optional)
MAX_LOG_SIZE_MB=10
MAX_LOG_LINES=50000
RATE_LIMIT=10/minute
ASK_TIMEOUT_SECONDS=60
# Comma-separated. For Netlify + Railway, include your Netlify origin, e.g.
# CORS_ORIGINS=https://your-app.netlify.app,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:5173

# Observability (optional). On Railway without Phoenix, set SKIP_PHOENIX=true
PHOENIX_PORT=6006
SKIP_PHOENIX=false

# Evals
MAX_EVAL_ROWS=15
